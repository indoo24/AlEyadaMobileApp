**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------------------
# AlEyada additions
# ---------------------------------------------------------------------------

# Release signing. The keystore and its passwords must never be committed; see
# "Release signing" in the README for how to supply them locally.
android/key.properties
*.jks
*.keystore
*.p12
*.pem
*.mobileprovision
*.cer
*.certSigningRequest
ios/Runner/GoogleService-Info.plist
android/app/google-services.json

# Local environment overrides. Configuration is passed with --dart-define; if a
# developer keeps a helper script with their own values, it stays out of git.
.env
.env.*
!.env.example

# Build output and local tool state
build/
.gradle/
android/.gradle/
android/local.properties
ios/Pods/
ios/.symlinks/
coverage/
*.log

# Editor / OS noise
.vscode/
*.iml
Thumbs.db
